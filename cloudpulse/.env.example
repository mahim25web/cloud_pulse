# ---- Shared (all services) ----
APP_ENV=development                 # development | production | test
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
LOG_LEVEL=info

# ---- Web app (Vercel) ----
NEXT_PUBLIC_FIREBASE_API_KEY=placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id
SESSION_COOKIE_SECRET=replace-with-32+-random-chars
# Production: use Workload Identity Federation / service account JSON via Vercel env, never commit it.

# ---- Pub/Sub topics ----
PUBSUB_TOPIC_CHECK_REQUESTED=cloudpulse-check-requested
PUBSUB_TOPIC_CHECK_COMPLETED=cloudpulse-check-completed
PUBSUB_TOPIC_INCIDENT_EVENTS=cloudpulse-incident-events
PUBSUB_TOPIC_NOTIFICATIONS=cloudpulse-notifications
PUBSUB_TOPIC_AI_ANALYSIS=cloudpulse-ai-analysis

# ---- Scheduler -> dispatcher auth (OIDC) ----
SCHEDULER_OIDC_AUDIENCE=https://dispatcher-xxxxx.run.app
SCHEDULER_SERVICE_ACCOUNT_EMAIL=scheduler-sa@your-gcp-project-id.iam.gserviceaccount.com

# ---- Email (Resend) ----
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder
EMAIL_FROM="CloudPulse <alerts@example.com>"

# ---- AI (Gemini, server-side only) ----
GEMINI_API_KEY=placeholder
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT_PER_WORKSPACE=20

# ---- Local dev ----
# Use Application Default Credentials: gcloud auth application-default login
# Optional emulators: FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
